# Copy: copy .env.example .env
#
# ── LOCAL Django (py manage.py runserver) ─────────────────────────────
#   docker compose --profile infra up -d
#   scripts\start_local_worker.bat
#
# DJANGO_DB_HOST=127.0.0.1
# REDIS_HOST=127.0.0.1
#
# ── FULL Docker stack ─────────────────────────────────────────────────
#   docker compose --profile infra --profile app up --build -d
# (web/worker use DJANGO_DB_HOST=db and REDIS_HOST=redis from compose)

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (local host — overridden to "db" inside Docker app containers)
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306
DJANGO_DB_NAME=__django_app_db__
DJANGO_DB_USER=root
DJANGO_DB_PASSWORD=88226858

# Redis (local host — overridden to "redis" inside Docker app containers)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Background scans (requires Redis + rqworker)
SCAN_USE_BACKGROUND_QUEUE=true

# Optional
# GITHUB_TOKEN=

# Docker Compose — keep MYSQL_ROOT_PASSWORD == DJANGO_DB_PASSWORD
MYSQL_ROOT_PASSWORD=88226858
MYSQL_PORT=3306
REDIS_PORT=6379
WEB_PORT=8000
PHPMYADMIN_PORT=8080
